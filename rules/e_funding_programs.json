  "rules": [
    {
      "id": "bch.chf.eligibility",
      "title": "BC Housing Community Housing Fund: eligibility and unit mix",
      "jurisdiction": "BC Housing",
      "applies_to_districts": ["*"],
      "check": "chf_fit",
      "versions": [
        {
          "effective_from": "2025-05-30",
          "params": {
            "eligible_proponent_types": ["non_profit_society", "housing_cooperative", "municipal_housing_provider", "first_nation"],
            "mix": {"market": 0.30, "rgi": 0.50, "deep_subsidy": 0.20},
            "mix_tolerance": 0.02,
            "low_moderate_income_limits_cad": {"under_two_bed": 85870, "two_bed_plus": 138770, "effective": "2025-03-01"},
            "min_lease_years_nominal": 60,
            "min_accessible_unit_share": 0.05,
            "readiness_site_control": ["finalized", "purchase_agreement", "letter_of_intent", "council_resolution"],
            "readiness_construction_start_months_after_award": 18,
            "provisional_grant_per_unit_cad_2025_26": 171211,
            "rated_weights": {"development": 0.60, "operations": 0.40},
            "rated_thresholds": {"development": 0.35, "operations": 0.25},
            "status": "2025 call (RFP #1070-2526-022) cancelled Feb 2026; program page says it will post when next seeking proposals (as of 22 Sep 2026)"
          },
          "source": {
            "title": "BC Housing, Community Housing Fund 2025 RFP #1070-2526-022 webinar slides; 2023 RFP #1070-2324-041; CHF program page",
            "url": "https://www.bchousing.org/sites/default/files/media/documents/CHF-RFP-2526-022A-Webinar-Slides.pdf",
            "section": "Eligibility; unit mix 30/50/20; minimum requirements; rated criteria",
            "rfp_2023_url": "https://www.bchousing.org/sites/default/files/media/documents/CHF-RFP-2324-041-Community-Housing-Fund-Overview.pdf",
            "program_url": "https://www.bchousing.org/projects-partners/Building-BC/CHF"
          }
        }
      ]
    },
    {
